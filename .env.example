# Copy to .env to override settings (all prefixed FORGE_, see app/config.py).

# Low-memory mode for 16 GB machines: one LLM for both tiers, so no weight swapping.
# Comment these out to demo real cheap (3B) / smart (8B) routing.
FORGE_CHEAP_MODEL=llama3.1:latest
FORGE_SMART_MODEL=llama3.1:latest

# FORGE_OLLAMA_HOST=http://localhost:11434
# FORGE_CACHE_THRESHOLD=0.93
